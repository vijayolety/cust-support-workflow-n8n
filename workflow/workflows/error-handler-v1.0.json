      ]
    },
    {
      "parameters": {
        "jsCode": "// Redacted alert: workflow/node/error class only. No email content.\nconst e = $input.first().json;\nconst cfg = $('E0 - Config').first().json;\nconst msg = String((e.execution && e.execution.error && e.execution.error.message) || 'unknown error').slice(0, 300);\nconst body = [\n  'An unhandled failure occurred in the support email automation. Some messages may be stuck in PROCESSING; see the recovery steps in the handover notes.',\n  '',\n  'Workflow: ' + (e.workflow && e.workflow.name),\n  'Execution ID: ' + (e.execution && e.execution.id),\n  'Failed node: ' + (e.execution && e.execution.lastNodeExecuted),\n  'Error: ' + msg,\n  'Execution URL: ' + (e.execution && e.execution.url),\n  'Time: ' + new Date().toISOString(),\n].join('\\n');\nreturn [{ json: { to: cfg.ownerEmail, subject: '[Support Automation ERROR] ' + (e.workflow && e.workflow.name), body } }];\n"
      },
      "id": "7833fa82-24a9-4813-925f-6e70cb9c2ec6",
